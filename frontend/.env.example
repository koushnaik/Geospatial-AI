# =====================================================================
# GeoFlood AI — Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# =====================================================================

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=production
LOG_LEVEL=info

# Geospatial Mapping Configuration
# CARTO Basemaps API Key (Optional / Recommended)
# If omitted, GeoFlood AI automatically falls back to OpenStreetMap.
# Obtain a free public key at: https://carto.com/basemaps/apikey
VITE_CARTO_API_KEY=your_carto_api_key_here

# Mapbox public access token (Optional)
# If provided, enables official Mapbox vector/satellite tiles.
# Obtain a free public key at: https://account.mapbox.com/
VITE_MAPBOX_ACCESS_TOKEN=your_mapbox_token_here
