# =====================================================================
# GeoFlood AI — Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# =====================================================================

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=production
LOG_LEVEL=info

# Geospatial Mapping Configuration
# Mapbox public access token (Optional)
# If provided, enables official Mapbox vector/satellite tiles.
# If omitted or invalid, GeoFlood AI automatically and safely falls back
# to high-resolution CartoDB Positron and OpenStreetMap without crashing.
# Obtain a free public key at: https://account.mapbox.com/
VITE_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_token_here
